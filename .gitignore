# Output images (renders, segmentation results, mesh screenshots)
images/
*.png
*.jpg
*.jpeg

# If you want to keep a few reference images tracked despite the rules above,
# whitelist them explicitly, e.g.:
# !images/keep_this.png

# Always keep documentation images tracked
!documentation/images/
!documentation/images/*.png
!documentation/images/*.jpg
!documentation/images/*.jpeg

# macOS
*.DS_Store

# Turntable / segmentation pipeline outputs
turntable_output/
segmentation_output/
outputs/

# Model checkpoints (large binaries, re-downloadable)
*.pt
*.pth
*.ckpt

# Python
image2model/
__pycache__/
*.pyc

# Blender backups
*.blend1
*.blend2

# 3D
*.glb
*.fbx
*.obj
